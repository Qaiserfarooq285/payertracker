# /etc/pitchvision/gateway.env -- environment for the always-on gateway (apps/gateway/main.py).
# Written once by docker/vps/setup_vps.sh from the values you pass it; edit here afterwards and
# `systemctl restart pitchvision-gateway`. Never commit real values.

# The login for the web UI. The SAME value is handed to the pod (PV_ACCESS_PASSWORD there), so
# the gateway can log in to it. Default if blank: admin1122 (apps/api/access.py) -- change it.
PV_ACCESS_PASSWORD=

# RunPod -> Settings -> API Keys -> Restricted, "pods" read/write (the gateway starts, creates and
# terminates the pod) -- the same key the pod uses to stop itself when idle.
RUNPOD_API_KEY=

# This gateway's public URL (setup_vps.sh sets it to https://$DOMAIN). Informational: the gateway
# PUSHES each new pod its code through RunPod's proxy (2026-09-30) -- a pod cannot reach this VPS --
# so no GitHub token is needed anywhere.
PV_PUBLIC_URL=

# Optional: installed on the pod for `ssh root@<ip> -p <port>` (one line, "ssh-ed25519 AAAA...").
PV_POD_SSH_PUBLIC_KEY=

# Optional: passed through to the pod (celebration / key-moment stage).
GEMINI_API_KEY=

# Pod shape (defaults are what the owner runs; apps/gateway/runpod_pods.py):
# PV_POD_NAME=pitchvision
# PV_VOLUME_NAME=pitchvision-data
# PV_DATACENTER=EUR-IS-1
# PV_GPU_TYPES=NVIDIA L4,NVIDIA RTX A4500,NVIDIA RTX 4000 Ada Generation,NVIDIA GeForce RTX 4090
# PV_IDLE_STOP_MINUTES=30      # the pod's own idle stop (needs its app up)
# PV_GPU_IDLE_MINUTES=10       # the gateway stops a billing pod with no job/use for this long (0 = never)
# PV_GATEWAY_DATA=/var/lib/pitchvision
